+/**
+ * @file
+ * PCM to DSD encoder using libdsd_upsample.
+ *
+ * The input is double-precision planar PCM at 44.1, 88.2, 176.4 or
+ * 352.8 kHz, or at 48, 96, 192 or 384 kHz, which the library resamples by
+ * 147/160 to the 44.1 kHz family first; the output is DSD64, DSD128 or
+ * DSD256, most significant bit first, one plane per channel in each packet.
+ * As for the other DSD codecs, the sample rate of the output is the DSD bit
+ * rate divided by 8 (one byte per sample); the encoder sets it during init.
+ */
+
+#include <math.h>
+
+#include <dsd_upsample.h>
+
+#include "libavutil/channel_layout.h"
+#include "libavutil/mem.h"
+#include "libavutil/opt.h"
+
+#include "avcodec.h"
+#include "codec_internal.h"
+#include "encode.h"
+
+typedef struct LibDSDUpsampleContext {
+    const AVClass *class;
+    int rate;
+    int order;
+    double gain;
+    int dither;
+
+    dsdup_stream *stream;
+    int channels;
+    uint8_t *buf[DSDUP_MAX_CHANNELS];   ///< output not yet packetized
+    unsigned buf_alloc[DSDUP_MAX_CHANNELS];
+    size_t buf_size;                    ///< bytes in each of buf[]
+    int64_t first_pts;
+    int64_t out_samples;                ///< output samples packetized so far
+    int err;                            ///< error from the output callback
+    int flushed;
+} LibDSDUpsampleContext;
+
+static int dsdup_error(AVCodecContext *avctx, int32_t status)
+{
+    av_log(avctx, AV_LOG_ERROR, "libdsd_upsample: %s\n", dsdup_last_error());
+
+    switch (status) {
+    case DSDUP_ERR_INVALID_ARGUMENT:
+    case DSDUP_ERR_UNSUPPORTED:      return AVERROR(EINVAL);
+    default:                         return AVERROR_EXTERNAL;
+    }
+}
+
+static int32_t output_cb(void *user, const uint8_t *const *channels,
+                         uint32_t nb_channels, size_t bytes)
+{
+    AVCodecContext *avctx = user;
+    LibDSDUpsampleContext *s = avctx->priv_data;
+
+    if (nb_channels != s->channels ||
+        bytes > INT_MAX / s->channels - s->buf_size) {
+        s->err = AVERROR(ERANGE);
+        return 1;
+    }
+
+    for (int ch = 0; ch < s->channels; ch++) {
+        uint8_t *buf = av_fast_realloc(s->buf[ch], &s->buf_alloc[ch],
+                                       s->buf_size + bytes);
+        if (!buf) {
+            s->err = AVERROR(ENOMEM);
+            return 1;
+        }
+        s->buf[ch] = buf;
+        memcpy(buf + s->buf_size, channels[ch], bytes);
+    }
+    s->buf_size += bytes;
+
+    return 0;
+}
+
+static av_cold int libdsdupsample_init(AVCodecContext *avctx)
+{
+    LibDSDUpsampleContext *s = avctx->priv_data;
+    dsdup_settings settings;
+    int32_t status;
+
+    s->channels  = avctx->ch_layout.nb_channels;
+    s->first_pts = AV_NOPTS_VALUE;
+
+    if (s->channels < 1 || s->channels > DSDUP_MAX_CHANNELS) {
+        av_log(avctx, AV_LOG_ERROR, "1 to %d channels are supported\n",
+               DSDUP_MAX_CHANNELS);
+        return AVERROR(EINVAL);
+    }
+
+    if (avctx->time_base.num <= 0 || avctx->time_base.den <= 0) {
+        av_log(avctx, AV_LOG_ERROR, "Invalid time base %d/%d\n",
+               avctx->time_base.num, avctx->time_base.den);
+        return AVERROR(EINVAL);
+    }
+    if (s->rate != 64 && s->rate != 128 && s->rate != 256) {
+        av_log(avctx, AV_LOG_ERROR, "dsd_rate must be 64, 128 or 256, not %d\n",
+               s->rate);
+        return AVERROR(EINVAL);
+    }
+    if (s->order != -1 && (s->order < 5 || s->order > 8)) {
+        av_log(avctx, AV_LOG_ERROR, "order must be auto (-1) or 5 to 8, not %d\n",
+               s->order);
+        return AVERROR(EINVAL);
+    }
+    if (s->rate == 128 && s->order == 8) {
+        /* as the library: order 8 in the audio band is unstable at DSD128 */
+        av_log(avctx, AV_LOG_ERROR,
+               "modulator order 8: DSD128 output accepts 5, 6, 7\n");
+        return AVERROR(EINVAL);
+    }
+
+    status = dsdup_settings_init(&settings, s->rate);
+    if (status != DSDUP_OK)
+        return dsdup_error(avctx, status);
+    if (s->order >= 0)
+        settings.order = s->order;
+    if (!isnan(s->gain))
+        settings.gain_db = s->gain; /* else the library's default */
+    settings.dither  = s->dither;
+
+    status = dsdup_stream_new(&settings, DSDUP_IN_PCM, avctx->sample_rate,
+                              s->channels, output_cb, avctx, &s->stream);
+    if (status != DSDUP_OK)
+        return dsdup_error(avctx, status);
+
+    /* the output is DSD at 44100 * rate bits per second, one byte per sample */
+    avctx->sample_rate           = 44100 * s->rate / 8;
+    avctx->bits_per_coded_sample = 8;
+    avctx->block_align           = s->channels;
+    avctx->bit_rate              = 8LL * s->channels * avctx->sample_rate;
+
+    av_log(avctx, AV_LOG_VERBOSE, "libdsd_upsample %s, DSD%d\n",
+           dsdup_version(), s->rate);
+
+    return 0;
+}
+
+static int libdsdupsample_encode(AVCodecContext *avctx, AVPacket *pkt,
+                                 const AVFrame *frame, int *got_packet_ptr)
+{
+    LibDSDUpsampleContext *s = avctx->priv_data;
+    int32_t status = DSDUP_OK;
+    int64_t pts;
+    int ret;
+
+    if (frame) {
+        if (frame->ch_layout.nb_channels != s->channels)
+            return AVERROR(EINVAL);
+        if (s->first_pts == AV_NOPTS_VALUE)
+            s->first_pts = frame->pts != AV_NOPTS_VALUE ? frame->pts : 0;
+        status = dsdup_stream_push_pcm(s->stream,
+                                       (const double *const *)frame->extended_data,
+                                       frame->nb_samples);
+    } else if (!s->flushed) {
+        s->flushed = 1;
+        status = dsdup_stream_finish(s->stream, NULL);
+    }
+    if (s->err < 0)
+        return s->err;
+    if (status != DSDUP_OK)
+        return dsdup_error(avctx, status);
+
+    if (!s->buf_size)
+        return 0;
+
+    ret = ff_get_encode_buffer(avctx, pkt, s->buf_size * s->channels, 0);
+    if (ret < 0)
+        return ret;
+    for (int ch = 0; ch < s->channels; ch++)
+        memcpy(pkt->data + ch * s->buf_size, s->buf[ch], s->buf_size);
+
+    pts = av_rescale_q(s->out_samples, (AVRational){ 1, avctx->sample_rate },
+                       avctx->time_base);
+    s->out_samples += s->buf_size;
+    pkt->pts = pkt->dts = s->first_pts + pts;
+    pkt->duration = av_rescale_q(s->out_samples,
+                                 (AVRational){ 1, avctx->sample_rate },
+                                 avctx->time_base) - pts;
+    s->buf_size = 0;
+
+    *got_packet_ptr = 1;
+    return 0;
+}
+
+static av_cold int libdsdupsample_close(AVCodecContext *avctx)
+{
+    LibDSDUpsampleContext *s = avctx->priv_data;
+
+    dsdup_stream_free(s->stream);
+    s->stream = NULL;
+    for (int ch = 0; ch < DSDUP_MAX_CHANNELS; ch++)
+        av_freep(&s->buf[ch]);
+
+    return 0;
+}
+
+#define OFFSET(x) offsetof(LibDSDUpsampleContext, x)
+#define AE AV_OPT_FLAG_AUDIO_PARAM | AV_OPT_FLAG_ENCODING_PARAM
+static const AVOption options[] = {
+    { "dsd_rate", "Output DSD rate, as a multiple of 44.1 kHz", OFFSET(rate),
+      AV_OPT_TYPE_INT, { .i64 = 128 }, 64, 256, AE, .unit = "dsd_rate" },
+        { "dsd64",  "2.8224 MHz",  0, AV_OPT_TYPE_CONST, { .i64 = 64  }, 0, 0, AE, .unit = "dsd_rate" },
+        { "dsd128", "5.6448 MHz",  0, AV_OPT_TYPE_CONST, { .i64 = 128 }, 0, 0, AE, .unit = "dsd_rate" },
+        { "dsd256", "11.2896 MHz", 0, AV_OPT_TYPE_CONST, { .i64 = 256 }, 0, 0, AE, .unit = "dsd_rate" },
+    { "order", "Modulator order, 5 to 8", OFFSET(order),
+      AV_OPT_TYPE_INT, { .i64 = -1 }, -1, 8, AE, .unit = "order" },
+        { "auto", "Library default for the output rate", 0, AV_OPT_TYPE_CONST, { .i64 = -1 }, 0, 0, AE, .unit = "order" },
+    { "gain", "Gain in dB applied before the modulator (default: the library's)", OFFSET(gain),
+      AV_OPT_TYPE_DOUBLE, { .dbl = NAN }, -120.0, 24.0, AE },
+    { "dither", "Add TPDF dither before the modulator", OFFSET(dither),
+      AV_OPT_TYPE_BOOL, { .i64 = 0 }, 0, 1, AE },
+    { NULL },
+};
+
+static const AVClass libdsdupsample_class = {
+    .class_name = "libdsdupsample",
+    .item_name  = av_default_item_name,
+    .option     = options,
+    .version    = LIBAVUTIL_VERSION_INT,
+};
+
+const FFCodec ff_libdsdupsample_encoder = {
+    .p.name         = "libdsdupsample",
+    CODEC_LONG_NAME("libdsd_upsample DSD (Direct Stream Digital)"),
+    .p.type         = AVMEDIA_TYPE_AUDIO,
+    .p.id           = AV_CODEC_ID_DSD_MSBF_PLANAR,
+    .p.capabilities = AV_CODEC_CAP_DR1 | AV_CODEC_CAP_DELAY |
+                      AV_CODEC_CAP_VARIABLE_FRAME_SIZE,
+    .p.priv_class   = &libdsdupsample_class,
+    .p.wrapper_name = "libdsdupsample",
+    .priv_data_size = sizeof(LibDSDUpsampleContext),
+    .init           = libdsdupsample_init,
+    FF_CODEC_ENCODE_CB(libdsdupsample_encode),
+    .close          = libdsdupsample_close,
+    CODEC_SAMPLEFMTS(AV_SAMPLE_FMT_DBLP),
+    CODEC_SAMPLERATES(44100, 88200, 176400, 352800,
+                      48000, 96000, 192000, 384000),
+};
