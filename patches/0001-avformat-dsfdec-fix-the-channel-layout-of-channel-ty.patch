From 08459b9f45dee9f00f68dd2a37b5c4993f2fa0c6 Mon Sep 17 00:00:00 2001
From: aclater <105859+aclater@users.noreply.github.com>
Date: Mon, 23 Nov 2026 21:08:46 +0100
Subject: [PATCH 1/3] avformat/dsfdec: fix the channel layout of channel type 5

The DSF specification defines channel type 5 ("4 channels") as front
left, front right, center and low frequency, which is 3.1, not 4.0.

Signed-off-by: aclater <105859+aclater@users.noreply.github.com>
---
 libavformat/dsfdec.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/libavformat/dsfdec.c b/libavformat/dsfdec.c
index c8f5bb5..e0d9cd1 100644
--- a/libavformat/dsfdec.c
+++ b/libavformat/dsfdec.c
@@ -45,7 +45,7 @@ static const AVChannelLayout dsf_channel_layout[] = {
     AV_CHANNEL_LAYOUT_STEREO,
     AV_CHANNEL_LAYOUT_SURROUND,
     AV_CHANNEL_LAYOUT_QUAD,
-    AV_CHANNEL_LAYOUT_4POINT0,
+    AV_CHANNEL_LAYOUT_3POINT1,
     AV_CHANNEL_LAYOUT_5POINT0_BACK,
     AV_CHANNEL_LAYOUT_5POINT1_BACK,
 };
-- 
2.56.1

