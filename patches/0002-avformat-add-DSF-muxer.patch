+
+/**
+ * @file
+ * DSD Stream File (DSF) muxer
+ *
+ * The audio data is written as one 4096-byte block per channel in turn,
+ * least significant bit first (bits per sample 1); the last block of each
+ * channel is padded with zeros. The sizes in the header are filled in by
+ * the trailer. Global metadata and chapters are written as an ID3v2 tag
+ * after the data.
+ */
+
+#include <string.h>
+
+#include "libavutil/channel_layout.h"
+#include "libavutil/dict.h"
+#include "libavutil/mem.h"
+#include "libavutil/opt.h"
+#include "libavutil/reverse.h"
+#include "avformat.h"
+#include "avio_internal.h"
+#include "id3v2.h"
+#include "internal.h"
+#include "mux.h"
+
+#define DSF_BLOCK_SIZE      4096
+#define DSF_MAX_CHANNELS    6
+#define DSF_HEADER_SIZE     (28 + 52 + 12)
+#define DSF_FILE_SIZE_POS   12
+#define DSF_SAMPLE_COUNT_POS 64
+#define DSF_DATA_SIZE_POS   84
+
+typedef struct DSFMuxContext {
+    const AVClass *class;
+    int write_id3v2;
+    int id3v2_version;
+    int planar;
+    int msbf;
+    int channels;
+    int fill;               ///< bytes buffered per channel
+    uint64_t nb_bytes;      ///< bytes written per channel, without padding
+    uint64_t nb_blocks;     ///< blocks written per channel
+    uint8_t *block;         ///< one block per channel
+} DSFMuxContext;
+
+/** Channel layouts indexed by channel type, as read by the DSF demuxer. */
+static const AVChannelLayout dsf_channel_layout[] = {
+    { 0 },
+    AV_CHANNEL_LAYOUT_MONO,
+    AV_CHANNEL_LAYOUT_STEREO,
+    AV_CHANNEL_LAYOUT_SURROUND,
+    AV_CHANNEL_LAYOUT_QUAD,
+    AV_CHANNEL_LAYOUT_3POINT1,
+    AV_CHANNEL_LAYOUT_5POINT0_BACK,
+    AV_CHANNEL_LAYOUT_5POINT1_BACK,
+};
+
+/** Channel type for a channel count without a known layout. */
+static const uint8_t dsf_default_channel_type[DSF_MAX_CHANNELS + 1] = {
+    0, 1, 2, 3, 4, 6, 7,
+};
+
+static int dsf_channel_type(AVFormatContext *s, const AVChannelLayout *layout)
+{
+    for (int i = 1; i < FF_ARRAY_ELEMS(dsf_channel_layout); i++)
+        if (!av_channel_layout_compare(layout, &dsf_channel_layout[i]))
+            return i;
+
+    if (layout->order != AV_CHANNEL_ORDER_UNSPEC)
+        av_log(s, AV_LOG_WARNING, "Channel layout not supported by DSF, "
+               "writing the default layout for %d channels\n",
+               layout->nb_channels);
+    return dsf_default_channel_type[layout->nb_channels];
+}
+
+static av_cold int dsf_init(AVFormatContext *s)
+{
+    DSFMuxContext *dsf = s->priv_data;
+    AVCodecParameters *par;
+
+    if (s->nb_streams != 1) {
+        av_log(s, AV_LOG_ERROR, "DSF files have exactly one audio stream\n");
+        return AVERROR(EINVAL);
+    }
+    par = s->streams[0]->codecpar;
+
+    switch (par->codec_id) {
+    case AV_CODEC_ID_DSD_LSBF:                    break;
+    case AV_CODEC_ID_DSD_MSBF:        dsf->msbf = 1; break;
+    case AV_CODEC_ID_DSD_LSBF_PLANAR: dsf->planar = 1; break;
+    case AV_CODEC_ID_DSD_MSBF_PLANAR: dsf->planar = dsf->msbf = 1; break;
+    default:
+        av_log(s, AV_LOG_ERROR, "Only DSD codecs are supported in DSF\n");
+        return AVERROR(EINVAL);
+    }
+
+    dsf->channels = par->ch_layout.nb_channels;
+    if (dsf->channels < 1 || dsf->channels > DSF_MAX_CHANNELS) {
+        av_log(s, AV_LOG_ERROR, "DSF supports 1 to %d channels, not %d\n",
+               DSF_MAX_CHANNELS, dsf->channels);
+        return AVERROR(EINVAL);
+    }
+    if (par->sample_rate <= 0 || par->sample_rate > UINT32_MAX / 8) {
+        av_log(s, AV_LOG_ERROR, "Invalid sample rate %d\n", par->sample_rate);
+        return AVERROR(EINVAL);
+    }
+
+    dsf->block = av_malloc(DSF_BLOCK_SIZE * dsf->channels);
+    if (!dsf->block)
+        return AVERROR(ENOMEM);
+
+    avpriv_set_pts_info(s->streams[0], 64, 1, par->sample_rate);
+
+    return 0;
+}
+
+static int dsf_write_header(AVFormatContext *s)
+{
+    DSFMuxContext *dsf = s->priv_data;
+    AVCodecParameters *par = s->streams[0]->codecpar;
+    AVIOContext *pb = s->pb;
+
+    if (!(pb->seekable & AVIO_SEEKABLE_NORMAL))
+        av_log(s, AV_LOG_WARNING, "Output is not seekable, "
+               "the header will not have the file and data sizes\n");
+
+    /* DSD chunk; file size and metadata offset are written by the trailer */
+    ffio_wfourcc(pb, "DSD ");
+    avio_wl64(pb, 28);
+    avio_wl64(pb, 0);
+    avio_wl64(pb, 0);
+
+    /* fmt chunk */
+    ffio_wfourcc(pb, "fmt ");
+    avio_wl64(pb, 52);
+    avio_wl32(pb, 1);                       /* format version */
+    avio_wl32(pb, 0);                       /* format id: raw */
+    avio_wl32(pb, dsf_channel_type(s, &par->ch_layout));
+    avio_wl32(pb, dsf->channels);
+    avio_wl32(pb, par->sample_rate * 8U);
+    avio_wl32(pb, 1);                       /* bits per sample: LSB first */
+    avio_wl64(pb, 0);                       /* sample count */
+    avio_wl32(pb, DSF_BLOCK_SIZE);
+    avio_wl32(pb, 0);                       /* reserved */
+
+    /* data chunk */
+    ffio_wfourcc(pb, "data");
+    avio_wl64(pb, 12);
+
+    return 0;
+}
+
+static void dsf_write_block(AVFormatContext *s)
+{
+    DSFMuxContext *dsf = s->priv_data;
+
+    for (int ch = 0; ch < dsf->channels; ch++)
+        memset(dsf->block + ch * DSF_BLOCK_SIZE + dsf->fill, 0,
+               DSF_BLOCK_SIZE - dsf->fill);
+    avio_write(s->pb, dsf->block, DSF_BLOCK_SIZE * dsf->channels);
+    dsf->nb_blocks++;
+    dsf->fill = 0;
+}
+
+static int dsf_write_packet(AVFormatContext *s, AVPacket *pkt)
+{
+    DSFMuxContext *dsf = s->priv_data;
+    const int channels = dsf->channels;
+    int nb_samples, pos = 0;
+
+    if (pkt->size % channels) {
+        av_log(s, AV_LOG_ERROR, "Packet size %d is not a multiple of "
+               "the channel count %d\n", pkt->size, channels);
+        return AVERROR(EINVAL);
+    }
+    nb_samples = pkt->size / channels;
+
+    while (pos < nb_samples) {
+        int n = FFMIN(nb_samples - pos, DSF_BLOCK_SIZE - dsf->fill);
+
+        for (int ch = 0; ch < channels; ch++) {
+            uint8_t *dst = dsf->block + ch * DSF_BLOCK_SIZE + dsf->fill;
+            const uint8_t *src;
+            int stride;
+
+            if (dsf->planar) {
+                src    = pkt->data + ch * nb_samples + pos;
+                stride = 1;
+            } else {
+                src    = pkt->data + pos * channels + ch;
+                stride = channels;
+            }
+
+            if (dsf->msbf) {
+                for (int i = 0; i < n; i++)
+                    dst[i] = ff_reverse[src[i * stride]];
+            } else if (stride == 1) {
+                memcpy(dst, src, n);
+            } else {
+                for (int i = 0; i < n; i++)
+                    dst[i] = src[i * stride];
+            }
+        }
+
+        dsf->fill += n;
+        pos       += n;
+        if (dsf->fill == DSF_BLOCK_SIZE)
+            dsf_write_block(s);
+    }
+    dsf->nb_bytes += nb_samples;
+
+    return 0;
+}
+
+static int dsf_write_trailer(AVFormatContext *s)
+{
+    DSFMuxContext *dsf = s->priv_data;
+    AVIOContext *pb = s->pb;
+    uint64_t data_size, id3_pos = 0;
+    int64_t file_size, end, pos;
+    int id3_ret = 0;
+
+    if (dsf->fill)
+        dsf_write_block(s);
+    data_size = dsf->nb_blocks * DSF_BLOCK_SIZE * dsf->channels;
+
+    if (dsf->write_id3v2 && (av_dict_count(s->metadata) || s->nb_chapters)) {
+        id3_pos = avio_tell(pb);
+        id3_ret = ff_id3v2_write_simple(s, dsf->id3v2_version, ID3v2_DEFAULT_MAGIC);
+    }
+
+    if (!(pb->seekable & AVIO_SEEKABLE_NORMAL))
+        return id3_ret;
+
+    end = file_size = avio_tell(pb);
+    if (file_size < 0)
+        return file_size;
+    /* A failed tag still gets a valid header for the audio: the file ends
+     * where the tag would have started, and there is no metadata pointer. */
+    if (id3_ret < 0) {
+        file_size = id3_pos;
+        id3_pos   = 0;
+    }
+
+    if ((pos = avio_seek(pb, DSF_FILE_SIZE_POS, SEEK_SET)) < 0)
+        return pos;
+    avio_wl64(pb, file_size);
+    avio_wl64(pb, id3_pos);
+    if ((pos = avio_seek(pb, DSF_SAMPLE_COUNT_POS, SEEK_SET)) < 0)
+        return pos;
+    avio_wl64(pb, dsf->nb_bytes * 8);
+    if ((pos = avio_seek(pb, DSF_DATA_SIZE_POS, SEEK_SET)) < 0)
+        return pos;
+    avio_wl64(pb, 12 + data_size);
+    if ((pos = avio_seek(pb, end, SEEK_SET)) < 0)
+        return pos;
+
+    return id3_ret;
+}
+
+static av_cold void dsf_deinit(AVFormatContext *s)
+{
+    DSFMuxContext *dsf = s->priv_data;
+
+    av_freep(&dsf->block);
+}
+
+#define OFFSET(x) offsetof(DSFMuxContext, x)
+#define ENC AV_OPT_FLAG_ENCODING_PARAM
+static const AVOption options[] = {
+    { "write_id3v2", "Write the global metadata as an ID3v2 tag",
+      OFFSET(write_id3v2), AV_OPT_TYPE_BOOL, { .i64 = 1 }, 0, 1, ENC },
+    { "id3v2_version", "ID3v2 version to write (3 or 4)",
+      OFFSET(id3v2_version), AV_OPT_TYPE_INT, { .i64 = 4 }, 3, 4, ENC },
+    { NULL },
+};
+
+static const AVClass dsf_muxer_class = {
+    .class_name = "DSF muxer",
+    .item_name  = av_default_item_name,
+    .option     = options,
+    .version    = LIBAVUTIL_VERSION_INT,
+};
+
+const FFOutputFormat ff_dsf_muxer = {
+    .p.name           = "dsf",
+    .p.long_name      = NULL_IF_CONFIG_SMALL("DSD Stream File (DSF)"),
+    .p.extensions     = "dsf",
+    .p.audio_codec    = AV_CODEC_ID_DSD_MSBF,
+    .p.video_codec    = AV_CODEC_ID_NONE,
+    .p.subtitle_codec = AV_CODEC_ID_NONE,
+    .p.flags          = AVFMT_NOTIMESTAMPS,
+    .p.priv_class     = &dsf_muxer_class,
+    .priv_data_size   = sizeof(DSFMuxContext),
+    .flags_internal   = FF_OFMT_FLAG_MAX_ONE_OF_EACH,
+    .init             = dsf_init,
+    .write_header     = dsf_write_header,
+    .write_packet     = dsf_write_packet,
+    .write_trailer    = dsf_write_trailer,
+    .deinit           = dsf_deinit,
+};
