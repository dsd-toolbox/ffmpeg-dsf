new file mode 100644
index 0000000..b8c4506
--- /dev/null
+++ b/tests/fate/dsf.mak
@@ -0,0 +1,27 @@
+# The generated WAV file is used as arbitrary DSD data (raw, 2 channels).
+DSF_RAW_INPUT = -ac 2 -ar 352800 -request_sample_fmt dsd
+
+# interleaved, most significant bit first: dsd_msbf encoder, bits reversed by the muxer
+FATE_DSF_FFMPEG_FFPROBE-$(call TRANSCODE, DSD_MSBF, DSF, PCM_U8_DEMUXER DSD_LSBF_PLANAR_DECODER) += fate-dsf-dsd-msbf
+fate-dsf-dsd-msbf: tests/data/asynth-44100-2.wav
+fate-dsf-dsd-msbf: CMD = transcode u8 $(TARGET_PATH)/tests/data/asynth-44100-2.wav dsf \
+    "-c:a dsd_msbf -metadata title=dsftest" "-c:a dsd_msbf" \
+    "-show_entries stream=codec_name,sample_rate,channels,channel_layout,duration:format_tags" \
+    "" "-request_sample_fmt dsd" "$(DSF_RAW_INPUT) -c:a dsd_msbf"
+
+# planar, least significant bit first: stream copy, blocks of the input packet size
+FATE_DSF_FFMPEG_FFPROBE-$(call REMUX, DSF, PCM_U8_DEMUXER DSD_LSBF_PLANAR_DECODER) += fate-dsf-dsd-lsbf-planar-copy
+fate-dsf-dsd-lsbf-planar-copy: tests/data/asynth-44100-2.wav
+fate-dsf-dsd-lsbf-planar-copy: CMD = transcode u8 $(TARGET_PATH)/tests/data/asynth-44100-2.wav dsf \
+    "-c:a copy" "-c:a copy" "-show_entries stream=codec_name,sample_rate,channels,duration" \
+    "" "" "$(DSF_RAW_INPUT) -c:a dsd_lsbf_planar"
+
+# channel type 5 (3.1) round-trips through the muxer and the demuxer
+FATE_DSF_FFMPEG_FFPROBE-$(call REMUX, DSF, PCM_U8_DEMUXER DSD_LSBF_PLANAR_DECODER) += fate-dsf-3point1
+fate-dsf-3point1: tests/data/asynth-44100-2.wav
+fate-dsf-3point1: CMD = transcode u8 $(TARGET_PATH)/tests/data/asynth-44100-2.wav dsf \
+    "-c:a copy" "-c:a copy" "-show_entries stream=channels,channel_layout" \
+    "" "" "-ch_layout 3.1 -ar 352800 -t 0.5 -c:a dsd_lsbf_planar"
+
+FATE_FFMPEG_FFPROBE += $(FATE_DSF_FFMPEG_FFPROBE-yes)
+fate-dsf: $(FATE_DSF_FFMPEG_FFPROBE-yes)
diff --git a/tests/ref/fate/dsf-3point1 b/tests/ref/fate/dsf-3point1
new file mode 100644
index 0000000..aa905d4
--- /dev/null
